NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:3000
# Production example: FRONTEND_URL=https://biolegacy.vercel.app
# Multiple allowed origins can be comma-separated.

# Set DATABASE_URL or all four DB_* values.
DATABASE_URL=postgresql://postgres:password@localhost:5432/biolegacy
# Allow hosted databases enough time for DNS, TCP and TLS connection setup.
DB_CONNECTION_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=30000
# Tune per API instance. Keep: instance_count * DB_POOL_MAX + maintenance
# connections below the database provider's max_connections limit.
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=300
# Reject excess work quickly instead of allowing an unbounded in-memory queue.
DB_POOL_MAX_WAITING=500
# Keep zero locally; Render currently uses one trusted reverse-proxy hop.
TRUST_PROXY_HOPS=0
# Redis is preferred in multi-instance production. Postgres remains a safe
# shared fallback; memory is suitable only for local development/tests.
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://default:password@host:6379
API_RATE_LIMIT=1500
ANONYMOUS_API_RATE_LIMIT=20000
AUTH_RATE_LIMIT=30
# Keep service availability if the limiter store has a transient outage.
RATE_LIMIT_FAIL_OPEN=true
# Multi-instance-safe expired-attempt worker settings.
EXPIRY_SWEEP_INTERVAL_MS=5000
EXPIRY_SWEEP_BATCH_SIZE=100
EXPIRY_SWEEP_CONCURRENCY=5
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000
# Keep true locally. Set false in production and use npm run db:migrate as a release command.
RUN_MIGRATIONS_ON_START=true
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_NAME=biolegacy
# DB_PORT=5432

# Replace both values with separate, random secrets (at least 32 characters).
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ISSUER=biolegacy-api
JWT_AUDIENCE=biolegacy-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Keep the user-entered gate key separate from the server-to-server signing key.
# Set the same two distinct 32+ character random values in Vercel and Render.
ADMIN_PORTAL_ACCESS_KEY=
ADMIN_PORTAL_SIGNING_KEY=

# Optional seed account; set a private password before running db:seed.
SEED_ADMIN_EMAIL=admin@biolegacy.in
SEED_ADMIN_PASSWORD=replace-before-seeding
# For one-time password rotation only; remove after storing the new password.
# NEW_ADMIN_PASSWORD=

# Google Identity Services Web client ID (frontend reads it from /auth/providers).
GOOGLE_CLIENT_ID=

# Sign in with Apple website configuration (registered Services ID and return URL).
APPLE_CLIENT_ID=
APPLE_REDIRECT_URL=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the complete .p8 private key here; encode line breaks as \n.
APPLE_PRIVATE_KEY=

# Phone OTP provider. Use 2Factor for the Indian SMS OTP account.
OTP_PROVIDER=2factor
TWO_FACTOR_API_KEY=
# Optional until an approved custom OTP template is available.
TWO_FACTOR_OTP_TEMPLATE=
TWO_FACTOR_API_BASE_URL=https://2factor.in/API/V1

# Optional Twilio fallback. Set OTP_PROVIDER=twilio to use it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay Standard Checkout. Keep KEY_SECRET and WEBHOOK_SECRET backend-only.
# Use Test Mode keys until the complete staging checklist passes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Private PDF storage using Cloudflare R2 (S3-compatible).
# Keep these values only in the backend. Never add them to the frontend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=biolegacy-pdfs
# Optional override. The default is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
PDF_MAX_FILE_SIZE_MB=25
# Application-level guard below R2's 10 GB free storage allocation.
PDF_STORAGE_QUOTA_MB=9000
# Private view/download links expire after this many seconds (60-3600).
PDF_SIGNED_URL_TTL_SECONDS=600
