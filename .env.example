NODE_ENV=development
PORT=7000
FRONTEND_URL=http://localhost:3000
# Production example: FRONTEND_URL=https://biolegacy.vercel.app
# Multiple allowed origins can be comma-separated.

# Set DATABASE_URL or all four DB_* values.
DATABASE_URL=postgresql://postgres:password@localhost:5432/biolegacy
# Allow hosted databases enough time for DNS, TCP and TLS connection setup.
DB_CONNECTION_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=30000
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_NAME=biolegacy
# DB_PORT=5432

# Replace both values with separate, random secrets (at least 32 characters).
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Optional seed account; set a private password before running db:seed.
SEED_ADMIN_EMAIL=admin@biolegacy.in
SEED_ADMIN_PASSWORD=replace-before-seeding
# For one-time password rotation only; remove after storing the new password.
# NEW_ADMIN_PASSWORD=

# Google Identity Services Web client ID (frontend reads it from /auth/providers).
GOOGLE_CLIENT_ID=

# Sign in with Apple website configuration (registered Services ID and return URL).
APPLE_CLIENT_ID=
APPLE_REDIRECT_URL=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the complete .p8 private key here; encode line breaks as \n.
APPLE_PRIVATE_KEY=

# Twilio Verify SMS OTP (keep these backend-only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay Standard Checkout. Keep KEY_SECRET and WEBHOOK_SECRET backend-only.
# Use Test Mode keys until the complete staging checklist passes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
