  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node -e \"require('./src/db/migrate')().then(() => { console.log('Database migration complete'); process.exit(0); }).catch((error) => { console.error(error); process.exit(1); })\"",
    "db:seed": "node src/scripts/seed.js",
    "auth:rotate-admin": "node src/scripts/rotate-admin-password.js",
    "content:seed-blogs": "node src/scripts/seed-blogs.js",
    "db:seed-neet": "node src/scripts/seed-neet.js",
    "smoke": "node src/scripts/smoke-test.js",
    "smoke:neet-e2e": "node src/scripts/e2e-neet-smoke.js",
    "payments:reconcile": "node src/scripts/reconcile-payments.js",
    "test": "node --test --test-isolation=none src/tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuuuuu0094/biolegacy_backend.git"
